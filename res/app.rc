#include <winver.h>

// App icon: a green battery, generated by tools/make-icon.ps1.
1 ICON "app.ico"
1 24 "app.manifest"

// The built-in UI languages: lang\*.txt joined by the build (see src/i18n.cpp).
LANGS RCDATA "languages.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "BatteryBar"
      VALUE "ProductName", "BatteryBar"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "BatteryBar.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
